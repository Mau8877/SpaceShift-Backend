# =========================================================================
# SpaceShift Backend - Environment Variables Template (.env.example)
# =========================================================================
# Instrucciones:
# 1. Copia este archivo y renombralo como '.env' en la raíz del backend.
# 2. Reemplaza los valores de ejemplo con tus credenciales locales reales.
# 3. NO subas tu archivo '.env' real al control de versiones (Git).
# =========================================================================

# ----------------- CONFIGURACIÓN GENERAL -----------------
SPRING_APPLICATION_NAME=api
# En application.properties: spring.application.name=${SPRING_APPLICATION_NAME:api}

SERVER_PORT=8081
# En application.properties: server.port=${SERVER_PORT:8081}


# ----------------- CONEXIÓN A POSTGRESQL -----------------
DB_HOST=localhost
# En application.properties: (usado en spring.datasource.url)

DB_PORT=5432
# En application.properties: (usado en spring.datasource.url)

DB_NAME=SW1_v1
# En application.properties: (usado en spring.datasource.url)

# URL completa generada en application.properties:
# spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:SW1_v1}

DB_USERNAME=postgres
# En application.properties: spring.datasource.username=${DB_USERNAME:postgres}

DB_PASSWORD=password
# En application.properties: spring.datasource.password=${DB_PASSWORD:password}


# ----------------- CONFIGURACIONES DE ORM / FLYWAY -----------------
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# En application.properties: spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:validate}

SPRING_FLYWAY_ENABLED=true
# En application.properties: spring.flyway.enabled=${SPRING_FLYWAY_ENABLED:true}

SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false
# En application.properties: spring.flyway.validate-on-migrate=${SPRING_FLYWAY_VALIDATE_ON_MIGRATE:false}


# ----------------- SEGURIDAD Y JWT -----------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# En application.properties: jwt.secret=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}

JWT_EXPIRATION=86400000
# En application.properties: jwt.expiration=${JWT_EXPIRATION:86400000}


# ----------------- MONITOREO Y DEBUGGING -----------------
LOGGING_LEVEL_WEB=DEBUG
# En application.properties: logging.level.org.springframework.web=${LOGGING_LEVEL_WEB:DEBUG}

LOG_REQUEST_DETAILS=true
# En application.properties: spring.mvc.log-request-details=${LOG_REQUEST_DETAILS:true}


# ----------------- CLOUDINARY (Servidor de Imágenes) -----------------
CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
# En application.properties: cloudinary.cloud_name=${CLOUDINARY_CLOUD_NAME:tu_cloudinary_cloud_name}

CLOUDINARY_API_KEY=tu_cloudinary_api_key
# En application.properties: cloudinary.api_key=${CLOUDINARY_API_KEY:tu_cloudinary_api_key}

CLOUDINARY_API_SECRET=tu_cloudinary_api_secret
# En application.properties: cloudinary.api_secret=${CLOUDINARY_API_SECRET:tu_cloudinary_api_secret}


# ----------------- CONFIGURACIÓN DE CORREO (Gmail SMTP) -----------------
MAIL_HOST=smtp.gmail.com
# En application.properties: spring.mail.host=${MAIL_HOST:smtp.gmail.com}

MAIL_PORT=587
# En application.properties: spring.mail.port=${MAIL_PORT:587}

MAIL_USERNAME=tu_correo_gmail@gmail.com
# En application.properties: spring.mail.username=${MAIL_USERNAME:tu_correo_gmail@gmail.com}

MAIL_PASSWORD=tu_contrasena_de_aplicacion_gmail
# En application.properties: spring.mail.password=${MAIL_PASSWORD:tu_contrasena_de_aplicacion_gmail}


# ----------------- TAMAÑO DE SUBIDA DE ARCHIVOS -----------------
MULTIPART_MAX_FILE_SIZE=5MB
# En application.properties: spring.servlet.multipart.max-file-size=${MULTIPART_MAX_FILE_SIZE:5MB}

MULTIPART_MAX_REQUEST_SIZE=50MB
# En application.properties: spring.servlet.multipart.max-request-size=${MULTIPART_MAX_REQUEST_SIZE:50MB}


# ----------------- PASARELA DE PAGOS STRIPE -----------------
STRIPE_SECRET_KEY=sk_test_tu_llave_secreta_privada
# En application.properties: stripe.secret-key=${STRIPE_SECRET_KEY:sk_test_tu_llave_secreta_privada}

STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secreto
# En application.properties: stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_tu_webhook_secreto}

STRIPE_SUCCESS_URL=http://localhost:3000/profile?success=true
# En application.properties: stripe.success-url=${STRIPE_SUCCESS_URL:http://localhost:3000/profile?success=true}

STRIPE_CANCEL_URL=http://localhost:3000/profile?cancel=true
# En application.properties: stripe.cancel-url=${STRIPE_CANCEL_URL:http://localhost:3000/profile?cancel=true}


# ----------------- AMAZON S3 (Almacenamiento en la Nube) -----------------
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
# En application.properties: aws.access-key-id=${AWS_ACCESS_KEY_ID:your_aws_access_key_id}

AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
# En application.properties: aws.secret-access-key=${AWS_SECRET_ACCESS_KEY:your_aws_secret_access_key}

AWS_REGION=AWS_REGION
# En application.properties: aws.region=${AWS_REGION:us-east-2}

AWS_S3_BUCKET_NAME=tu_s3_bucket_name
# En application.properties: aws.s3.bucket-name=${AWS_S3_BUCKET_NAME:sw1proyectog}